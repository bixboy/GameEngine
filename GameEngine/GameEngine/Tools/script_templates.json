{
  "root_namespace": "Engine::Game",
  "templates": [
    {
      "name": "Actor",
      "description": "Base gameplay actor",
      "header": {
        "includes": ["CoreMinimal.h"],
        "body": [
          "class {class_name} : public Actor",
          "{",
          "public:",
          "    {class_name}();",
          "    void Update(float deltaTime) override;",
          "};"
        ]
      },
      "source": {
        "includes": ["{header_include}"],
        "body": [
          "{class_name}::{class_name}() {}",
          "void {class_name}::Update(float deltaTime) {",
          "    // TODO",
          "}"
        ]
      }
    },
    {
      "name": "Component",
      "description": "Attachable component",
      "header": {
        "includes": ["CoreMinimal.h"],
        "body": [
          "class {class_name} : public Component",
          "{",
          "public:",
          "    {class_name}(Actor* owner);",
          "    void Update(float deltaTime) override;",
          "};"
        ]
      },
      "source": {
        "includes": ["{header_include}"],
        "body": [
          "{class_name}::{class_name}(Actor* owner) : Component(owner) {}",
          "void {class_name}::Update(float deltaTime) {",
          "    // TODO",
          "}"
        ]
      }
    }
  ]
}